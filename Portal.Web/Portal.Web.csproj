<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableSdkContainerDebugging>True</EnableSdkContainerDebugging>
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0-noble-chiseled-extra</ContainerBaseImage>
    <ContainerRepository>tasou/portal</ContainerRepository>
    <UserSecretsId>24692884-3f6a-4a3a-b173-aa05231f66df</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="sites/**/*" />
    <Content Remove="sites/**/*" />
    <None Include="sites/**/*" />
  </ItemGroup>

  <Target Name="CompileTypeScript" BeforeTargets="Build">
    <Exec Command="npm install" WorkingDirectory="$(ProjectDir)" Condition="!Exists('$(ProjectDir)node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(ProjectDir)" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Portal.ServiceDefaults\Portal.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.43.0" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" Version="4.13.1" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Emoji" Version="4.13.1" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Icons" Version="4.13.1" />
  </ItemGroup>

  <ItemGroup>
    <ContainerPort Include="8081" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="TypeScript\" />
  </ItemGroup>

</Project>
