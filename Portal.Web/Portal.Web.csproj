<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableSdkContainerDebugging>True</EnableSdkContainerDebugging>
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0-noble-chiseled-extra</ContainerBaseImage>
    <ContainerRepository>tasou/portal</ContainerRepository>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <UserSecretsId>24692884-3f6a-4a3a-b173-aa05231f66df</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="sites/**/*" />
    <Content Remove="sites/**/*" />
    <None Include="sites/**/*" />
  </ItemGroup>

  <Target Name="CompileTypeScript" BeforeTargets="CoreBuild">
    <Exec Command="npm install" WorkingDirectory="$(ProjectDir)" Condition="!Exists('$(ProjectDir)node_modules')" />
    <Exec Command="npm run dev" WorkingDirectory="$(ProjectDir)" Condition="'$(Configuration)' == 'Debug'" />
    <Exec Command="npm run build" WorkingDirectory="$(ProjectDir)" Condition="'$(Configuration)' != 'Debug'" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Portal.ServiceDefaults\Portal.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="KubernetesClient" Version="19.0.2" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" Version="4.14.4" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Emoji" Version="4.14.2" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Icons" Version="4.14.4" />
    <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ContainerPort Include="8081" />
  </ItemGroup>

</Project>
