{
  "name": "portal.web",
  "version": "1.0.0",
  "description": "TypeScript files for Portal.Web Blazor application",
  "sideEffects": [
    "**/*.css",
    "./ts/blazor-reconnect.ts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && webpack --mode production",
    "watch": "concurrently --kill-others-on-fail --names typecheck,webpack \"tsc --noEmit --watch --preserveWatchOutput\" \"webpack --mode development --watch\"",
    "dev": "npm run typecheck && webpack --mode development",
    "clean": "rimraf wwwroot/dist"
  },
  "dependencies": {
    "bootstrap-icons": "^1.13.1",
    "detectincognitojs": "^1.6.2",
    "ua-parser-js": "^2.0.10"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ua-parser-js": "^0.7.39",
    "concurrently": "^10.0.5",
    "css-loader": "^7.1.4",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "esbuild": "^0.28.2",
    "esbuild-loader": "^4.5.0",
    "mini-css-extract-plugin": "^2.10.2",
    "rimraf": "^6.1.3",
    "terser-webpack-plugin": "^5.6.0",
    "typescript": "^7.0.0",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.0"
  }
}
