@page "/"

@using System.Security.Claims
@inject ISiteDetails SubsiteService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>@SubsiteService.Name</PageTitle>

<FluentStack Orientation="Orientation.Vertical" Width="100%">
    @if (!string.IsNullOrEmpty(SubsiteService.Description))
    {
        <FluentCard>
            <FluentLabel Typo="Typography.Body">@SubsiteService.Description</FluentLabel>
        </FluentCard>
    }

    @if (categorizedSubsites.Any())
    {
        @foreach (var category in categorizedSubsites.Keys.OrderBy(k => k))
        {
            <FluentStack Orientation="Orientation.Vertical" Width="100%" Style="margin-bottom: 2rem;">
                <FluentLabel Typo="Typography.H2">@category</FluentLabel>
                <SubsiteGrid Subsites="@categorizedSubsites[category]"
                             SelectedSubsite="@selectedSubsite"
                             OnSubsiteSelected="@HandleSubsiteSelected"
                             OnUsageRequested="@HandleUsageRequested" />
            </FluentStack>
        }
    }
    else
    {
        <FluentMessageBar Intent="MessageIntent.Warning">
            <FluentStack Orientation="Orientation.Vertical">
                <FluentLabel Typo="Typography.H4">No Sites Available</FluentLabel>
                <FluentLabel Typo="Typography.Body">There are currently no sites available for you to view. This may be because:</FluentLabel>
                <ul style="margin-top: 0.5rem;">
                    <li>No sites have been configured yet</li>
                    <li>You don't have permission to access any sites</li>
                    <li>All sites are currently unavailable</li>
                </ul>
                <FluentDivider Style="margin: 1rem 0;" />
                <FluentLabel Typo="Typography.Body">Please contact your administrator if you believe you should have access to sites.</FluentLabel>
            </FluentStack>
        </FluentMessageBar>
    }
</FluentStack>

<SubsiteDetailsPane Subsite="@selectedSubsite"
                    IsOpen="@isPaneOpen"
                    OnClose="@CloseDetailsPane" />

<UsageModal Subsite="@usageSubsite"
            IsOpen="@isUsageModalOpen"
            OnClose="@CloseUsageModal" />

@code {
    private Dictionary<string, List<SubsiteInfo>> categorizedSubsites = new();
    private SubsiteInfo? selectedSubsite;
    private bool isPaneOpen = false;
    private SubsiteInfo? usageSubsite;
    private bool isUsageModalOpen = false;

    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        // Load subsites from the service
        var allSubsites = SubsiteService.GetSites(state.User);

        // Group subsites by category
        categorizedSubsites = allSubsites
            .GroupBy(s => s.Category)
            .ToDictionary(g => g.Key, g => g.ToList());
    }

    private void HandleSubsiteSelected(SubsiteInfo subsite)
    {
        selectedSubsite = subsite;
        isPaneOpen = true;
    }

    private void CloseDetailsPane()
    {
        isPaneOpen = false;
    }

    private void HandleUsageRequested(SubsiteInfo subsite)
    {
        usageSubsite = subsite;
        isUsageModalOpen = true;
    }

    private void CloseUsageModal()
    {
        isUsageModalOpen = false;
    }
}
