@page "/"

<FluentStack Orientation="Orientation.Vertical">
    @if (categorizedSubsites.Any())
    {
        @foreach (var category in categorizedSubsites.Keys.OrderBy(k => k))
        {
            <SiteGrid Category="@category" Sites="@categorizedSubsites[category]" />
        }
    }
    else
    {
        <EmptySubsiteNotification />
    }
</FluentStack>

@code {
    [CascadingParameter]
    public PortalDetails? SiteDetails { get; set; } = null!;

    private Dictionary<string, List<SiteInfo>> categorizedSubsites = new();

    protected override async Task OnParametersSetAsync()
    {
        if (SiteDetails is { } details)
        {
            categorizedSubsites = new Dictionary<string, List<SiteInfo>>();

            foreach (var subsite in details.Sites)
            {
                // If subsite has no categories, add it to the empty/uncategorized group
                if (subsite.Categories.Count == 0)
                {
                    if (!categorizedSubsites.ContainsKey(string.Empty))
                    {
                        categorizedSubsites[string.Empty] = new List<SiteInfo>();
                    }
                    categorizedSubsites[string.Empty].Add(subsite);
                }
                else
                {
                    // Add the subsite to each of its categories
                    foreach (var category in subsite.Categories)
                    {
                        if (!categorizedSubsites.ContainsKey(category))
                        {
                            categorizedSubsites[category] = new List<SiteInfo>();
                        }
                        categorizedSubsites[category].Add(subsite);
                    }
                }
            }
        }
    }
}
