@page "/"

@if (SiteDetails is { Sites: { } sites } && sites.Any())
{
    <SiteSearchBar Sites="@SiteDetails.Sites">        
        @if (ViewMode == SiteViewMode.Categories)
        {
            <SiteCategoryView Sites="@context" />
        }
        else if (ViewMode == SiteViewMode.Frequency)
        {
            <SiteFrequencyView Sites="@context" />
        }
        else
        {
            <div style="display: flex; justify-content: center; align-items: center; height: 100%;">
                <FluentSpinner IsActive="true" />
            </div>
        }
    </SiteSearchBar>
}
else
{
    <EmptySubsiteNotification />
}

@code {
    [CascadingParameter]
    public PortalDetails? SiteDetails { get; set; } = null!;

    [CascadingParameter(Name = "CurrentViewMode")]
    public SiteViewMode ViewMode { get; set; }
}
