@page "/"

<FluentStack Orientation="Orientation.Vertical">
    @if (categorizedSubsites.Any())
    {
        @foreach (var category in categorizedSubsites.Keys.OrderBy(k => k))
        {
            <SubsiteGrid Category="@category" Subsites="@categorizedSubsites[category]" />
        }
    }
    else
    {
        <EmptySubsiteNotification />
    }
</FluentStack>

@code {
    [CascadingParameter]
    public ISiteDetails? SiteDetails { get; set; } = null!;

    private Dictionary<string, List<SubsiteInfo>> categorizedSubsites = new();

    protected override async Task OnParametersSetAsync()
    {
        if (SiteDetails is { } details)
        {
            categorizedSubsites = details.Sites
                .GroupBy(s => s.Category)
                .ToDictionary(g => g.Key, g => g.ToList());
        }
    }
}
