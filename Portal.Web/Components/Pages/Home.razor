@page "/"
@using System.Security.Claims
@inject ISiteDetails SubsiteService

<PageTitle>@SubsiteService.Name</PageTitle>

<SubsiteList Roles="@GetRoles()" />

@code {
    [CascadingParameter]
    public HttpContext? Context { get; set; }

    public string[] GetRoles()
    {
        if (Context?.User is { } user)
        {
            return [.. user.Claims
                .Where(c => c.Type == ClaimTypes.Role)
                .Select(c => c.Value)];
        }

        return [];
    }
}