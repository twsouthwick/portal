@inherits LayoutComponentBase

<FluentLayout Style="min-height: 100vh; background-color: var(--neutral-layer-1);">
    <FluentBodyContent Style="background-color: var(--neutral-layer-1);">
        <div class="content px-4">
            @Body
        </div>
    </FluentBodyContent>
</FluentLayout>

<FluentMessageBarProvider @rendermode="@InteractiveServer" />
<FluentDialogProvider @rendermode="@InteractiveServer" />
<FluentToastProvider @rendermode="@InteractiveServer" />
<FluentMenuProvider @rendermode="@InteractiveServer" />

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
