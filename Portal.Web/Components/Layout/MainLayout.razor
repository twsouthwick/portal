@inherits LayoutComponentBase

<ConnectionState>
    <SiteProvider>
        <CascadingValue TValue="SiteViewMode" Value="viewMode" Name="CurrentViewMode">
            <FluentLayout>
                <FluentHeader Height="default">
                    <PageTitle>@context.Name</PageTitle>

                    <div class="header-content">
                        <div class="header-title">
                            @if (string.IsNullOrEmpty(context.Description))
                            {
                                <span>@context.Name</span>
                            }
                            else
                            {
                                <span>@context.Name - @context.Description</span>
                            }
                        </div>
                        <div class="header-selector">
                            <SiteViewModeSelector @bind-CurrentMode="viewMode" />
                        </div>
                    </div>
                </FluentHeader>
                <FluentBodyContent>
                    <div class="centered-container">
                        @Body
                    </div>
                </FluentBodyContent>
            </FluentLayout>
        </CascadingValue>
    </SiteProvider>
</ConnectionState>

<FluentMessageBarProvider />
<FluentDialogProvider />
<FluentToastProvider />
<FluentMenuProvider />
<FluentDesignTheme StorageName="theme" />

<div id="blazor-error-ui">
    <FluentMessageBar Title="An unhandled error has occurred"
                      Intent="MessageIntent.Error"
                      AllowDismiss="false">
    </FluentMessageBar>
</div>

@code {
    private SiteViewMode viewMode = SiteViewMode.None;
}
