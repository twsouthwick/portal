@inherits LayoutComponentBase

<ConnectionState>
    <SiteProvider>
        <CascadingValue TValue="SiteViewMode" Value="viewMode" Name="CurrentViewMode">
            <FluentLayout>
                @* @spec UX-010 *@
                <FluentLayoutItem Area="LayoutArea.Header" Height="auto">
                    <header class="portal-header">
                    <PageTitle>@context.Name</PageTitle>

                    <div class="header-content">
                        <div class="header-title">
                            @if (string.IsNullOrEmpty(context.Description))
                            {
                                <span>@context.Name</span>
                            }
                            else
                            {
                                <span>@context.Name - @context.Description</span>
                            }
                        </div>
                        <div class="header-selector">
                            <SiteViewModeSelector @bind-CurrentMode="viewMode" />
                        </div>
                        <form method="post" action="/auth/logout" class="logout-form">
                            <AntiforgeryToken />
                            <button type="submit" class="logout-button" title="Sign out">
                                <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                                <span>Sign out</span>
                            </button>
                        </form>
                    </div>
                    </header>
                </FluentLayoutItem>
                <FluentLayoutItem Area="LayoutArea.Content">
                    <div class="centered-container">
                        @Body
                    </div>
                </FluentLayoutItem>
                <FluentLayoutItem Area="LayoutArea.Footer" Height="auto">
                    <VersionFooter />
                </FluentLayoutItem>
            </FluentLayout>
        </CascadingValue>
    </SiteProvider>
</ConnectionState>

<FluentProviders />

<div id="blazor-error-ui">
    <FluentMessageBar Title="An unhandled error has occurred"
                      Intent="MessageBarIntent.Error"
                      AllowDismiss="false">
    </FluentMessageBar>
</div>

@code {
    private SiteViewMode viewMode = SiteViewMode.None;
}
