@inherits LayoutComponentBase

<ConnectionState>
    <SiteProvider>
        <FluentLayout>
            <FluentHeader>
                <PageTitle>@context.Name</PageTitle>

                @if (string.IsNullOrEmpty(context.Description))
                {
                    <span>@context.Name</span>
                }
                else
                {
                    <span>@context.Name - @context.Description</span>
                }
            </FluentHeader>
            <FluentBodyContent>
                <div class="centered-container">
                    @Body
                </div>
            </FluentBodyContent>
        </FluentLayout>
    </SiteProvider>
</ConnectionState>

<FluentMessageBarProvider />
<FluentDialogProvider />
<FluentToastProvider />
<FluentMenuProvider />
<FluentDesignTheme StorageName="theme" />

<div id="blazor-error-ui">
    <FluentMessageBar 
        Title="An unhandled error has occurred"
        Intent="MessageIntent.Error"
        AllowDismiss="true">
        <FluentButton class="reload">
            Reload
        </FluentButton>
    </FluentMessageBar>
</div>
