@inherits LayoutComponentBase

<RemoteNetworkMessageBar />
<FluentLayout>
    <FluentBodyContent>
        <div class="centered-container">
            @Body
        </div>
    </FluentBodyContent>
</FluentLayout>

<FluentMessageBarProvider @rendermode="@InteractiveServer" />
<FluentDialogProvider @rendermode="@InteractiveServer" />
<FluentToastProvider @rendermode="@InteractiveServer" />
<FluentMenuProvider @rendermode="@InteractiveServer" />
<FluentDesignTheme StorageName="theme" @rendermode="InteractiveServer" />

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
