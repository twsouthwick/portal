@inject ILogger<SiteCategoryView> Logger

@* @spec UX-013 *@
@if (selectedCategory is not null)
{
    <button @ref="backButton" class="category-back" type="button" @onclick="ShowCategories">
        <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to categories
    </button>
    <SiteGrid Category="@selectedCategory" Sites="@categorizedSites[selectedCategory]" />
}
else
{
    <FluentText As="TextTag.H2" Size="TextSize.Size600" Weight="TextWeight.Semibold">Categories</FluentText>
    <FluentGrid Spacing="3" Style="width: 100%;">
        @foreach (var category in categorizedSites.Keys.OrderBy(k => k))
        {
            <FluentGridItem xs="12" sm="6" md="4" lg="3" @key="category">
                <button @ref="categoryButtons[category]" class="category-card" type="button"
                        data-category="@category" @onclick="() => SelectCategory(category)">
                    <i class="bi bi-folder" aria-hidden="true"></i>
                    <span class="category-name">@category</span>
                    <span class="category-count">@categorizedSites[category].Count @(categorizedSites[category].Count == 1 ? "site" : "sites")</span>
                </button>
            </FluentGridItem>
        }
    </FluentGrid>
}

@code {
    [Parameter, EditorRequired]
    public IEnumerable<SiteInfo> Sites { get; set; } = [];

    private Dictionary<string, List<SiteInfo>> categorizedSites = [];
    private readonly Dictionary<string, ElementReference> categoryButtons = [];
    private ElementReference backButton;
    private string? selectedCategory;
    private string? focusCategory;
    private bool focusBack;

    protected override void OnParametersSet()
    {
        categorizedSites = [];
        categoryButtons.Clear();

        foreach (var site in Sites)
        {
            var categories = site.Categories.Count == 0 ? ["Other"] : site.Categories;
            foreach (var category in categories.Distinct())
            {
                if (!categorizedSites.TryGetValue(category, out var group))
                {
                    group = [];
                    categorizedSites.Add(category, group);
                }
                group.Add(site);
            }
        }

        if (selectedCategory is not null && !categorizedSites.ContainsKey(selectedCategory))
        {
            selectedCategory = null;
            focusCategory = categorizedSites.Keys.OrderBy(k => k).FirstOrDefault();
        }
    }

    private void SelectCategory(string category)
    {
        selectedCategory = category;
        focusBack = true;
    }

    private void ShowCategories()
    {
        focusCategory = selectedCategory;
        selectedCategory = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        ElementReference? target = focusBack ? backButton
            : focusCategory is not null && categoryButtons.TryGetValue(focusCategory, out var button) ? button : null;
        focusBack = false;
        focusCategory = null;
        if (target is { } element)
        {
            try
            {
                await element.FocusAsync();
            }
            catch (JSException exception)
            {
                Logger.LogWarning(exception, "Could not focus category navigation.");
            }
        }
    }
}
