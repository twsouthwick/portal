<FluentCard Class="@GetCardClass()" Style="cursor: pointer;">
    <FluentStack Orientation="Orientation.Vertical" Width="100%" VerticalGap="12">
        <div class="subsite-icon" style="font-size: 2rem;">
            <i class="@Subsite.Icon"></i>
        </div>

        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
            <FluentLabel Typo="Typography.H5">@Subsite.Name</FluentLabel>
            <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-rest);">
                @Subsite.Description
            </FluentLabel>
        </FluentStack>

        <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.End" HorizontalGap="8" Style="margin-top: auto;" @onclick:stopPropagation="true">
            @if (!string.IsNullOrEmpty(Subsite.UsageInstructions))
            {
                <FluentButton Appearance="Appearance.Outline" 
                              OnClick="@HandleUsageClick"
                              IconStart="@(new Icons.Regular.Size16.QuestionCircle())">
                    How to Use
                </FluentButton>
            }
            <FluentButton Appearance="Appearance.Accent"
                          OnClick="@NavigateToSite"
                          IconEnd="@(new Icons.Regular.Size16.ArrowRight())">
                Visit Site
            </FluentButton>
        </FluentStack>
    </FluentStack>
</FluentCard>

@code {
    [Parameter]
    public SubsiteInfo Subsite { get; set; } = new();

    [Parameter]
    public EventCallback<SubsiteInfo> OnUsageRequested { get; set; }

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    private string GetCardClass() => "subsite-card";

    private async Task HandleUsageClick()
    {
        await OnUsageRequested.InvokeAsync(Subsite);
    }

    private void NavigateToSite()
    {
        NavigationManager.NavigateTo(Subsite.Url, forceLoad: true);
    }
}
