@rendermode InteractiveServer

<FluentCard Class="subsite-card">
    <FluentStack Orientation="Orientation.Vertical" Width="100%" VerticalGap="12" Style="height: 100%;">
        <div class="subsite-icon" style="font-size: 2rem;">
            <i class="@Subsite.Icon"></i>
        </div>

        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8" Style="flex: 1;">
            <FluentLabel Typo="Typography.H5">@Subsite.Name</FluentLabel>
            <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-rest);">
                @Subsite.Description
            </FluentLabel>
        </FluentStack>

        <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.End" HorizontalGap="8">
            @if (!string.IsNullOrEmpty(Subsite.UsageInstructions))
            {
                <FluentButton Appearance="Appearance.Outline" 
                              OnClick="@ShowUsageModal"
                              IconStart="@(new Icons.Regular.Size16.QuestionCircle())">
                    How to Use
                </FluentButton>
            }
            <FluentAnchor Appearance="Appearance.Accent"
                          Href="@Subsite.Url"
                          Target="_blank">
                Visit Site
                <FluentIcon Value="@(new Icons.Regular.Size16.ArrowRight())" Color="@Color.Info" Slot="end" />
            </FluentAnchor>
        </FluentStack>
    </FluentStack>
</FluentCard>

@inject IDialogService DialogService

@code {
    [Parameter]
    public SubsiteInfo Subsite { get; set; } = null!;

    private async Task ShowUsageModal()
    {
        var dialog = await DialogService.ShowDialogAsync<UsageModal>(Subsite, new DialogParameters()
        {
            Title = $"{Subsite.Name} - Usage Guide",
            PrimaryAction = "Close",
            SecondaryAction = null,
            Width = "600px",
            Height = "auto",
            Modal = true,
            PreventDismissOnOverlayClick = false,
            ShowDismiss = true
        });

        var result = await dialog.Result;
    }
}
