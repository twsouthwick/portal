<FluentCard Class="@GetCardClass()" @onclick="HandleClick" Style="cursor: pointer;">
    <FluentStack Orientation="Orientation.Vertical" Width="100%">
        <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.SpaceBetween">
            <div class="subsite-icon" style="font-size: 2rem;">
                <i class="@Subsite.Icon"></i>
            </div>
            @if (Subsite.RequiresPermission)
            {
                <FluentBadge Appearance="Appearance.Accent" BackgroundColor="var(--warning)">
                    ??
                </FluentBadge>
            }
        </FluentStack>

        <FluentStack Orientation="Orientation.Vertical" Width="100%">
            <FluentLabel Typo="Typography.H5">@Subsite.Name</FluentLabel>
            <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-rest);">
                @Subsite.Description
            </FluentLabel>
            @if (!string.IsNullOrEmpty(Subsite.Category))
            {
                <FluentBadge Appearance="Appearance.Accent">@Subsite.Category</FluentBadge>
            }
        </FluentStack>

        <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.End" Style="margin-top: auto; gap: 0.5rem;">
            <FluentButton Appearance="Appearance.Outline" 
                          OnClick="@HandleUsageClick">
                ? How to Use
            </FluentButton>
            <FluentAnchor Href="@Subsite.Url" 
                          Appearance="Appearance.Accent">
                Visit Site ?
            </FluentAnchor>
        </FluentStack>
    </FluentStack>
</FluentCard>

@code {
    [Parameter]
    public SubsiteInfo Subsite { get; set; } = new();

    [Parameter]
    public bool IsSelected { get; set; }

    [Parameter]
    public EventCallback<SubsiteInfo> OnSelected { get; set; }

    [Parameter]
    public EventCallback<SubsiteInfo> OnUsageRequested { get; set; }

    private string GetCardClass() => IsSelected ? "subsite-card selected" : "subsite-card";

    private async Task HandleClick()
    {
        await OnSelected.InvokeAsync(Subsite);
    }

    private async Task HandleUsageClick()
    {
        await OnUsageRequested.InvokeAsync(Subsite);
    }
}
