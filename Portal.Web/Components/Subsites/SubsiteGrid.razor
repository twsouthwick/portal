<div class="subsite-grid">
    @foreach (var subsite in Subsites)
    {
        <SubsiteCard 
            Subsite="@subsite" 
            OnUsageRequested="@HandleUsageRequested" />
    }
</div>

@inject IDialogService DialogService

@code {
    [Parameter]
    public List<SubsiteInfo> Subsites { get; set; } = new();

    private async Task HandleUsageRequested(SubsiteInfo subsite)
    {
        var dialog = await DialogService.ShowDialogAsync<UsageModal>(subsite, new DialogParameters()
        {
            Title = $"{subsite.Name} - Usage Guide",
            PrimaryAction = "Close",
            SecondaryAction = null,
            Width = "600px",
            Height = "auto",
            Modal = false,
            PreventDismissOnOverlayClick = false,
            ShowDismiss = true
        });

        var result = await dialog.Result;
    }
}
