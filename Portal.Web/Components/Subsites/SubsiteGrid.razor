<div class="subsite-grid-container">
    <FluentStack Orientation="Orientation.Vertical" Width="100%" Style="margin-bottom: 2rem;">
        @if (!string.IsNullOrEmpty(Category))
        {
            <FluentLabel Typo="Typography.H2">@Category</FluentLabel>
        }

        <FluentGrid Spacing="3" Justify="JustifyContent.FlexStart" Style="width: 100%;">
            @if (Subsites is not null)
            {
                @foreach (var subsite in Subsites)
                {
                    <FluentGridItem xs="12" sm="6" md="4" lg="3">
                        <SubsiteCard Subsite="@subsite" />
                    </FluentGridItem>
                }
            }
        </FluentGrid>
    </FluentStack>
</div>

@code {
    [Parameter]
    public IEnumerable<SubsiteInfo>? Subsites { get; set; }

    [Parameter]
    public string? Category { get; set; }
}
