@using Portal.Web.Models

@* Overlay *@
<div class="subsite-details-overlay @(IsOpen ? "open" : "")" @onclick="Close"></div>

@* Details Pane *@
<div class="subsite-details-pane @(IsOpen ? "open" : "")">
    @if (Subsite != null)
    {
        <div class="subsite-details-header">
            <button class="subsite-details-close" @onclick="Close">
                <i class="bi bi-x-lg"></i>
            </button>
            <div class="subsite-icon mb-3">
                <i class="@Subsite.IconClass"></i>
            </div>
            <h3>@Subsite.Name</h3>
            <p class="mb-0">@Subsite.Description</p>
        </div>

        <div class="subsite-details-body">
            @if (!string.IsNullOrEmpty(Subsite.TargetAudience))
            {
                <div class="subsite-details-section">
                    <h6>Target Audience</h6>
                    <div class="info-badge">
                        <i class="bi bi-people-fill"></i>
                        <span>@Subsite.TargetAudience</span>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(Subsite.Category))
            {
                <div class="subsite-details-section">
                    <h6>Category</h6>
                    <div class="info-badge">
                        <i class="bi bi-tag-fill"></i>
                        <span>@Subsite.Category</span>
                    </div>
                </div>
            }

            @if (Subsite.RequiresPermission)
            {
                <div class="subsite-details-section">
                    <div class="alert alert-warning d-flex align-items-center">
                        <i class="bi bi-lock-fill me-2"></i>
                        <span>This subsite requires special permissions to access.</span>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(Subsite.UsageInstructions))
            {
                <div class="subsite-details-section">
                    <h6>How to Use</h6>
                    <p class="text-muted">@Subsite.UsageInstructions</p>
                </div>
            }

            @if (Subsite.Features.Any())
            {
                <div class="subsite-details-section">
                    <h6>Key Features</h6>
                    <ul>
                        @foreach (var feature in Subsite.Features)
                        {
                            <li>@feature</li>
                        }
                    </ul>
                </div>
            }

            @if (!string.IsNullOrEmpty(Subsite.Contact))
            {
                <div class="subsite-details-section">
                    <h6>Contact</h6>
                    <div class="info-badge">
                        <i class="bi bi-envelope-fill"></i>
                        <span>@Subsite.Contact</span>
                    </div>
                </div>
            }

            <div class="subsite-details-section">
                <a href="@Subsite.Url" class="btn btn-primary w-100">
                    <i class="bi bi-box-arrow-up-right me-2"></i>
                    Open @Subsite.Name
                </a>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public SubsiteInfo? Subsite { get; set; }

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
}
