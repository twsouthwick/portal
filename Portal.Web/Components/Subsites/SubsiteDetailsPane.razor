@* Details Panel using FluentDialog *@
@if (IsOpen && Subsite != null)
{
    <FluentDialog Hidden="@(!IsOpen)" 
                  Modal="false"
                  TrapFocus="false"
                  OnDismiss="Close"
                  Style="width: 400px; position: fixed; right: 0; top: 0; height: 100vh; margin: 0; z-index: 1000;">
        <FluentStack Orientation="Orientation.Vertical" Width="100%">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.SpaceBetween">
                <FluentLabel Typo="Typography.H3">Details</FluentLabel>
                <FluentButton Appearance="Appearance.Stealth" 
                              @onclick="Close">
                    ?
                </FluentButton>
            </FluentStack>

            <FluentDivider Style="margin: 1rem 0;" />

            <FluentStack Orientation="Orientation.Vertical" Width="100%" Style="align-items: center; margin-bottom: 1rem;">
                <div class="subsite-icon mb-3" style="font-size: 3rem;">
                    <i class="@Subsite.Icon"></i>
                </div>
                <FluentLabel Typo="Typography.H3">@Subsite.Name</FluentLabel>
                <FluentLabel Typo="Typography.Body" Style="text-align: center;">@Subsite.Description</FluentLabel>
            </FluentStack>

            @if (!string.IsNullOrEmpty(Subsite.TargetAudience))
            {
                <FluentStack Orientation="Orientation.Vertical" Width="100%" Style="margin-bottom: 1rem;">
                    <FluentLabel Typo="Typography.H6">Target Audience</FluentLabel>
                    <FluentStack Orientation="Orientation.Horizontal">
                        <span>??</span>
                        <FluentLabel>@Subsite.TargetAudience</FluentLabel>
                    </FluentStack>
                </FluentStack>
            }

            @if (!string.IsNullOrEmpty(Subsite.Category))
            {
                <FluentStack Orientation="Orientation.Vertical" Width="100%" Style="margin-bottom: 1rem;">
                    <FluentLabel Typo="Typography.H6">Category</FluentLabel>
                    <FluentStack Orientation="Orientation.Horizontal">
                        <span>???</span>
                        <FluentLabel>@Subsite.Category</FluentLabel>
                    </FluentStack>
                </FluentStack>
            }

            @if (!string.IsNullOrEmpty(Subsite.UsageInstructions))
            {
                <FluentStack Orientation="Orientation.Vertical" Width="100%" Style="margin-bottom: 1rem;">
                    <FluentLabel Typo="Typography.H6">How to Use</FluentLabel>
                    <MarkdownContent Content="@Subsite.UsageInstructions" Context="@Subsite" />
                </FluentStack>
            }

            @if (Subsite.Features.Any())
            {
                <FluentStack Orientation="Orientation.Vertical" Width="100%" Style="margin-bottom: 1rem;">
                    <FluentLabel Typo="Typography.H6">Key Features</FluentLabel>
                    <ul>
                        @foreach (var feature in Subsite.Features)
                        {
                            <li>@feature</li>
                        }
                    </ul>
                </FluentStack>
            }

            @if (!string.IsNullOrEmpty(Subsite.Contact))
            {
                <FluentStack Orientation="Orientation.Vertical" Width="100%" Style="margin-bottom: 1rem;">
                    <FluentLabel Typo="Typography.H6">Contact</FluentLabel>
                    <FluentStack Orientation="Orientation.Horizontal">
                        <span>??</span>
                        <FluentLabel>@Subsite.Contact</FluentLabel>
                    </FluentStack>
                </FluentStack>
            }

            <FluentAnchor Href="@Subsite.Url" 
                          Appearance="Appearance.Accent" 
                          Style="width: 100%;">
                Open @Subsite.Name ?
            </FluentAnchor>
        </FluentStack>
    </FluentDialog>
}

@code {
    [Parameter]
    public SubsiteInfo? Subsite { get; set; }

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
}
