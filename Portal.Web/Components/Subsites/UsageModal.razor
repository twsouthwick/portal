@using Markdig
@inject IMarkdownConverter Markdown

@if (IsOpen)
{
    <FluentDialog Hidden="@(!IsOpen)" 
                  Modal="true"
                  TrapFocus="true"
                  OnDismiss="Close">
        @if (Subsite != null)
        {
            <FluentDialogHeader>
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
                    <div class="usage-modal-icon" style="font-size: 2rem;">
                        <i class="@Subsite.Icon"></i>
                    </div>
                    <FluentStack Orientation="Orientation.Vertical">
                        <FluentLabel Typo="Typography.H4">@Subsite.Name</FluentLabel>
                        <FluentLabel Typo="Typography.Body" Style="opacity: 0.7;">Usage Guide</FluentLabel>
                    </FluentStack>
                </FluentStack>
            </FluentDialogHeader>

            <FluentDialogBody>
                @if (!string.IsNullOrEmpty(Subsite.UsageInstructions))
                {
                    <div style="margin-bottom: 1rem;">
                        <MarkdownContent Content="@Subsite.UsageInstructions" Context="@Subsite" />
                    </div>
                }
                else
                {
                    <FluentMessageBar Intent="MessageIntent.Info" Style="margin-bottom: 1rem;">
                        <FluentStack Orientation="Orientation.Horizontal">
                            <span>??</span>
                            <span>No usage instructions available for this subsite.</span>
                        </FluentStack>
                    </FluentMessageBar>
                }

                @if (Subsite.Features.Any())
                {
                    <FluentStack Orientation="Orientation.Vertical" Width="100%" Style="margin-top: 1rem;">
                        <FluentLabel Typo="Typography.H6" Style="text-transform: uppercase; opacity: 0.7;">Key Features</FluentLabel>
                        <ul class="feature-list">
                            @foreach (var feature in Subsite.Features)
                            {
                                <li>@feature</li>
                            }
                        </ul>
                    </FluentStack>
                }

                @if (!string.IsNullOrEmpty(Subsite.Contact))
                {
                    <FluentCard Style="margin-top: 1rem; padding: 1rem; background-color: var(--neutral-layer-2);">
                        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
                            <span>??</span>
                            <FluentLabel Style="font-weight: bold;">Need help?</FluentLabel>
                            <a href="mailto:@Subsite.Contact" style="margin-left: auto;">@Subsite.Contact</a>
                        </FluentStack>
                    </FluentCard>
                }
            </FluentDialogBody>

            <FluentDialogFooter>
                <FluentButton Appearance="Appearance.Neutral" @onclick="Close">Close</FluentButton>
                <FluentAnchor Href="@Subsite.Url" 
                              Appearance="Appearance.Accent">
                    Open @Subsite.Name ?
                </FluentAnchor>
            </FluentDialogFooter>
        }
    </FluentDialog>
}

@code {
    [Parameter]
    public SubsiteInfo? Subsite { get; set; }

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
}
