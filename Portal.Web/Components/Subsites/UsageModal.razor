@implements IDialogContentComponent<SubsiteInfo>
@inject NavigationManager NavigationManager
@inject IMarkdownConverter MarkdownConverter

<FluentDialogBody>
    <MarkdownSection HtmlContent="@GetMarkup()" />
</FluentDialogBody>

<FluentDialogHeader>
    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="12">
        <div class="usage-modal-icon" style="font-size: 2rem;">
            <i class="@Content.Icon"></i>
        </div>
        <FluentStack Orientation="Orientation.Vertical">
            <FluentLabel Typo="Typography.H4">@Content.Name</FluentLabel>
            <FluentLabel Typo="Typography.Body" Style="color: var(--text-secondary);">@Content.Description</FluentLabel>
        </FluentStack>
    </FluentStack>
</FluentDialogHeader>

<FluentDialogFooter>
    <FluentButton Appearance="Appearance.Neutral" OnClick="@(() => Dialog.CancelAsync())">
        Close
    </FluentButton>
    <FluentAnchor Appearance="Appearance.Accent"
                  Href="@Content.Url"
                  Target="_blank">
        Open @Content.Name
        <FluentIcon Value="@(new Icons.Regular.Size16.ArrowUpRight())" Color="@Color.Info" Slot="end" />
    </FluentAnchor>
</FluentDialogFooter>

@code {
    [Parameter]
    public SubsiteInfo Content { get; set; } = default!;

    [CascadingParameter]
    public FluentDialog Dialog { get; set; } = default!;

    private MarkupString GetMarkup()
    {
        return (MarkupString)MarkdownConverter.Convert(Content, Content.UsageInstructions);
    }
}
