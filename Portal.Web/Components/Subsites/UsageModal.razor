@implements IDialogContentComponent<SubsiteInfo>
@inject NavigationManager NavigationManager

<FluentDialogBody>
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="12">
            <div class="usage-modal-icon" style="font-size: 2rem;">
                <i class="@Content.Icon"></i>
            </div>
            <FluentStack Orientation="Orientation.Vertical">
                <FluentLabel Typo="Typography.H4">@Content.Name</FluentLabel>
                <FluentLabel Typo="Typography.Body" Style="opacity: 0.7;">Usage Guide</FluentLabel>
            </FluentStack>
        </FluentStack>

        <FluentDivider Style="margin: 0.5rem 0;" />

        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center">
                <FluentIcon Value="@(new Icons.Regular.Size20.Info())" />
                <FluentLabel Typo="Typography.H6" Style="margin: 0;">Usage Instructions</FluentLabel>
            </FluentStack>
            <MarkdownContent Content="@Content.UsageInstructions" Context="@Content" />
        </FluentStack>
    </FluentStack>
</FluentDialogBody>

<FluentDialogFooter>
    <FluentButton Appearance="Appearance.Neutral" OnClick="@(() => Dialog.CancelAsync())">
        Close
    </FluentButton>
    <FluentButton Appearance="Appearance.Accent"
                  OnClick="@NavigateToSite"
                  IconEnd="@(new Icons.Regular.Size16.ArrowUpRight())">
        Open @Content.Name
    </FluentButton>
</FluentDialogFooter>

@code {
    [Parameter]
    public SubsiteInfo Content { get; set; } = default!;

    [CascadingParameter]
    public FluentDialog Dialog { get; set; } = default!;

    private void NavigateToSite()
    {
        NavigationManager.NavigateTo(Content.Url, forceLoad: true);
    }
}
