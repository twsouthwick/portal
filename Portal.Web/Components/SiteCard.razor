@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IDialogService DialogService

<div class="subsite-card-wrapper">
    <FluentCard Class="subsite-card" Style="@CardStyle" @onclick="HandleCardClick">
        <FluentStack Orientation="Orientation.Vertical" Width="100%" VerticalGap="12" Style="height: 100%;">
            @if (IsDisabledDueToRemote)
            {
                <FluentMessageBar Title="Remote Connection Required" Intent="@MessageIntent.Warning" AllowDismiss="false" />
            }

            <div class="subsite-icon" style="font-size: 2rem;">
                <i class="@Site.Icon"></i>
            </div>

            <FluentStack Orientation="Orientation.Vertical" VerticalGap="8" Style="flex: 1;">
                <FluentLabel Typo="Typography.H5">@Site.Name</FluentLabel>
                <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-rest);">
                    @Site.Description
                </FluentLabel>
            </FluentStack>

            <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                <div @onclick:stopPropagation="true">
                    @if (!string.IsNullOrEmpty(Site.UsageInstructions))
                    {
                        <FluentButton Appearance="Appearance.Outline"
                                      OnClick="@ShowUsageModal"
                                      IconStart="@(new Icons.Regular.Size28.QuestionCircle())" />
                    }
                </div>

                <div @onclick:stopPropagation="true">
                    <SiteLinks Site="@Site" IsDisabled="@IsDisabledDueToRemote" />
                </div>
            </div>
        </FluentStack>
    </FluentCard>
</div>

@code {
    private IJSObjectReference? _module;

    [Parameter]
    public SiteInfo Site { get; set; } = null!;

    [CascadingParameter(Name = "RemoteIP")]
    public string? RemoteIp { get; set; } = null!;

    private bool IsDisabledDueToRemote => RemoteIp is { } && Site.IsInternal;

    private bool HasHttpUrl => !string.IsNullOrEmpty(Site.Url);

    private bool HasAppsOrUrl => Site.Apps.Count > 0 || HasHttpUrl;

    private string CardStyle => HasAppsOrUrl && !IsDisabledDueToRemote ? "cursor: pointer;" : "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && (Site.Apps.Count > 0 || HasHttpUrl))
        {
            _module = await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import",
                "./Components/SiteLauncher.razor.js");
        }
    }

    private async Task HandleCardClick()
    {
        if (IsDisabledDueToRemote || !HasAppsOrUrl)
        {
            return;
        }

        if (_module is null)
        {
            return;
        }

        // Try to launch each app in order
        foreach (var app in Site.Apps)
        {
            try
            {
                var result = await _module.InvokeAsync<bool>("launchAppUrl", app.Scheme);
                if (result)
                {
                    // App launched successfully, we're done
                    return;
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error launching app {app.Name}: {ex.Message}");
                // Continue to the next app
            }
        }

        // If all apps failed to launch (or there are no apps), open the website
        if (HasHttpUrl)
        {
            await JSRuntime.InvokeVoidAsync("open", Site.Url, "_blank");
        }
    }

    private async Task ShowUsageModal()
    {
        var dialog = await DialogService.ShowDialogAsync<UsageModal>(Site, new DialogParameters()
        {
            Title = $"{Site.Name} - Usage Guide",
            PrimaryAction = "Close",
            SecondaryAction = null,
            Width = "800px",
            Height = "auto",
            Modal = true,
            PreventDismissOnOverlayClick = false,
            ShowDismiss = true
        });

        var result = await dialog.Result;
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.DisposeAsync();
        }
    }
}
