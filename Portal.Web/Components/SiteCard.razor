@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IDialogService DialogService

<div class="subsite-card-wrapper">
    <FluentCard Class="subsite-card" Style="@CardStyle" @onclick="HandleCardClick">
        <FluentStack Orientation="Orientation.Vertical" Width="100%" VerticalGap="12" Style="height: 100%;">
            @if (IsDisabledDueToRemote)
            {
                <FluentMessageBar Title="Remote Connection Required" Intent="@MessageIntent.Warning" AllowDismiss="false" />
            }

            <div class="subsite-icon" style="font-size: 2rem;">
                <i class="@Site.Icon"></i>
            </div>

            <FluentStack Orientation="Orientation.Vertical" VerticalGap="8" Style="flex: 1;">
                <FluentLabel Typo="Typography.H5">@Site.Name</FluentLabel>
                <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-rest);">
                    @Site.Description
                </FluentLabel>
            </FluentStack>

            <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                <div @onclick:stopPropagation="true">
                    @if (!string.IsNullOrEmpty(Site.UsageInstructions))
                    {
                        <FluentButton Appearance="Appearance.Outline"
                                      OnClick="@ShowUsageModal"
                                      IconStart="@(new Icons.Regular.Size28.QuestionCircle())" />
                    }
                </div>
                
                <div @onclick:stopPropagation="true">
                    <SiteLinks Links="@Site.Links" IsDisabled="@IsDisabledDueToRemote" />
                </div>
            </div>
        </FluentStack>
    </FluentCard>
</div>

@code {
    [Parameter]
    public SiteInfo Site { get; set; } = null!;

    [CascadingParameter(Name = "RemoteIP")]
    public string? RemoteIp { get; set; } = null!;

    private bool IsDisabledDueToRemote => RemoteIp is { } && Site.IsInternal;

    private bool HasHttpLinks => Site.Links?.Any(l => 
        l.Url.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || 
        l.Url.StartsWith("https://", StringComparison.OrdinalIgnoreCase)) == true;

    private string CardStyle => HasHttpLinks && !IsDisabledDueToRemote ? "cursor: pointer;" : "";

    private async Task HandleCardClick()
    {
        if (IsDisabledDueToRemote || !HasHttpLinks)
        {
            return;
        }

        var firstHttpLink = Site.Links.FirstOrDefault(l => 
            l.Url.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || 
            l.Url.StartsWith("https://", StringComparison.OrdinalIgnoreCase));

        if (firstHttpLink is not null)
        {
            await JSRuntime.InvokeVoidAsync("open", firstHttpLink.Url, "_blank");
        }
    }

    private async Task ShowUsageModal()
    {
        var dialog = await DialogService.ShowDialogAsync<UsageModal>(Site, new DialogParameters()
        {
            Title = $"{Site.Name} - Usage Guide",
            PrimaryAction = "Close",
            SecondaryAction = null,
            Width = "800px",
            Height = "auto",
            Modal = true,
            PreventDismissOnOverlayClick = false,
            ShowDismiss = true
        });

        var result = await dialog.Result;
    }
}
