<FluentCard>
    <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" Style="padding: 2rem;">
        <FluentIcon Value="@(new Icons.Regular.Size48.Warning())" Color="Color.Warning" Style="font-size: 48px;" />
        <FluentLabel Typo="Typography.H3" Style="text-align: center;">No Sites Available</FluentLabel>
        <FluentLabel Typo="Typography.Body" Style="text-align: center; color: var(--neutral-foreground-rest);">
            There are currently no sites configured or you don't have permission to view any sites.
        </FluentLabel>
    </FluentStack>
</FluentCard>