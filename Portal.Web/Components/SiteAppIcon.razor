@if (!string.IsNullOrEmpty(DeterminedIcon))
{
    <i class="@DeterminedIcon"></i>
}
else
{
    <FluentIcon Value="@DefaultIcon" />
}

@code {
    [Parameter]
    public string Url { get; set; } = string.Empty;

    [Parameter]
    public AppStore? AppStore { get; set; }

    private bool IsAppProtocol => !string.IsNullOrEmpty(Url) &&
        Url.Contains("://") &&
        !Url.StartsWith("http://", StringComparison.OrdinalIgnoreCase) &&
        !Url.StartsWith("https://", StringComparison.OrdinalIgnoreCase);

    private Icon DefaultIcon => IsAppProtocol ? new Icons.Regular.Size28.Desktop() : new Icons.Regular.Size28.Globe();

    private string? DeterminedIcon
    {
        get
        {
            if (!IsAppProtocol || AppStore is null)
            {
                return null;
            }

            return AppStore.Name.ToLowerInvariant() switch
            {
                "google" => "bi bi-google-play",
                "google-play" => "bi bi-google-play",
                "ios" => "bi bi-apple",
                "apple" => "bi bi-apple",
                "macos" => "bi bi-apple",
                "windows" => "bi bi-windows",
                "microsoft" => "bi bi-windows",
                _ => null
            };
        }
    }
}
