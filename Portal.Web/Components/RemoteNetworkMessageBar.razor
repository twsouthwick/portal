@using System.Net
@rendermode RenderMode.InteractiveServer

@if (RemoteIP is { } && isInteractive)
{
    <FluentMessageBar Title="Remote Connection Detected" Intent="@MessageIntent.Warning">
        You are accessing this portal from a remote network (@RemoteIP). Some features may be restricted.
    </FluentMessageBar>
}

@code {
    [PersistentState]
    public string? RemoteIP { get; set; }

    [CascadingParameter]
    public HttpContext? Context { get; set; }

    private bool isInteractive = false;

    protected override void OnParametersSet()
    {
        if (RemoteIP is not { } && Context is { Connection.RemoteIpAddress: { } ip })
        {
            if (IsRemoteAddress(ip))
            {
                RemoteIP = ip.ToString();
            }
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            isInteractive = true;
            StateHasChanged();
        }
    }

    private static bool IsRemoteAddress(IPAddress ip)
    {
        // Check if it's loopback (127.0.0.1 or ::1)
        if (IPAddress.IsLoopback(ip))
        {
            return false;
        }

        // Convert to IPv4 if it's IPv6-mapped IPv4
        if (ip.IsIPv4MappedToIPv6)
        {
            ip = ip.MapToIPv4();
        }

        // Check private IP ranges for IPv4
        if (ip.AddressFamily == System.Net.Sockets.AddressFamily.InterNetwork)
        {
            var bytes = ip.GetAddressBytes();

            // 10.0.0.0 - 10.255.255.255
            if (bytes[0] == 10)
            {
                return false;
            }

            // 172.16.0.0 - 172.31.255.255
            if (bytes[0] == 172 && bytes[1] >= 16 && bytes[1] <= 31)
            {
                return false;
            }

            // 192.168.0.0 - 192.168.255.255
            if (bytes[0] == 192 && bytes[1] == 168)
            {
                return false;
            }

            // 169.254.0.0 - 169.254.255.255 (link-local)
            if (bytes[0] == 169 && bytes[1] == 254)
            {
                return false;
            }
        }
        // Check private IP ranges for IPv6
        else if (ip.AddressFamily == System.Net.Sockets.AddressFamily.InterNetworkV6)
        {
            // Check for unique local addresses (fc00::/7)
            var bytes = ip.GetAddressBytes();
            if ((bytes[0] & 0xfe) == 0xfc)
            {
                return false;
            }

            // Check for link-local addresses (fe80::/10)
            if (bytes[0] == 0xfe && (bytes[1] & 0xc0) == 0x80)
            {
                return false;
            }
        }

        return true;
    }
}
