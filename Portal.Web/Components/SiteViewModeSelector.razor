@* @spec UX-013 *@
<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8">
    <FluentLabel Typo="Typography.Body">View by:</FluentLabel>
    <FluentSelect Id="viewmode-selector"
                  Class="outline"
                  @bind-Value="@selectedValue"
                  TOption="string"
                  TValue="string"
                  Width="200px">
        <FluentOption Id="viewmode-categories" TOption="string" Value="@nameof(SiteViewMode.Categories)">
            <FluentIcon Value="@(new Icons.Regular.Size20.GridDots())" Slot="start" />
            Categories
        </FluentOption>
        <FluentOption Id="viewmode-frequency" TOption="string" Value="@nameof(SiteViewMode.Frequency)">
            <FluentIcon Value="@(new Icons.Regular.Size20.ChartMultiple())" Slot="start" />
            Most Used
        </FluentOption>
    </FluentSelect>
</FluentStack>

@code {
    [Parameter]
    public SiteViewMode CurrentMode
    {
        get;
        set
        {
            if (field != value)
            {
                field = value;
                CurrentModeChanged.InvokeAsync(value);
            }
        }
    }

    [Parameter]
    public EventCallback<SiteViewMode> CurrentModeChanged { get; set; }

    private string selectedValue
    {
        get => CurrentMode.ToString();
        set => CurrentMode = Enum.Parse<SiteViewMode>(value);
    }
}
