@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

@if (_filtered is { })
{
    <CascadingValue TValue="PortalDetails" Value="_filtered">
        @if (ChildContent is { })
        {
            @ChildContent(_filtered)
        }
    </CascadingValue>
}

@code {
    private PortalDetails? _filtered;

    [Parameter]
    public RenderFragment<PortalDetails>? ChildContent { get; set; }

    [Inject]
    public IPortalProvider PortalProvider { get; set; } = null!;

    [Inject]
    public AuthenticationStateProvider AuthStateProvider { get; set; } = null!;

    [Inject]
    public IClientBrowserSession BrowserSession { get; set; } = null!;

    [Inject]
    public ILogger<SiteProvider> Logger { get; set; } = null!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var portal = await PortalProvider.GetSiteDetailsAsync(default);
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            var isPrivate = await CheckIsPrivateModeAsync();
            _filtered = portal with { Sites = Filter(portal.Sites, state.User, isPrivate) };

            StateHasChanged();
        }
    }

    /// <summary>
    /// Detects if the browser is currently in private/incognito mode
    /// </summary>
    /// <returns>True if in private mode, false otherwise</returns>
    private async Task<bool> CheckIsPrivateModeAsync()
    {
        var result = await BrowserSession.IsPrivateModeAsync();
        Logger.LogInformation("Private mode detection result: {IsPrivateMode}", result);
        return result;
    }

    private IEnumerable<SiteInfo> Filter(IEnumerable<SiteInfo> other, ClaimsPrincipal user, bool isPrivate)
    {
        foreach (var site in other)
        {
            if (site.IsAuthorized(user))
            {
                if (site.IsPrivate && !isPrivate)
                {
                    continue;
                }

                yield return site;
            }
        }
    }
}
