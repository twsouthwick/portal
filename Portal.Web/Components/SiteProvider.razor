@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using Microsoft.JSInterop

@if (_filtered is { })
{
    <CascadingValue TValue="ISiteDetails" Value="_filtered">
        @if (ChildContent is { })
        {
            @ChildContent(_filtered)
        }
    </CascadingValue>
}

@code {
    private ISiteDetails? _filtered;

    [Parameter]
    public RenderFragment<ISiteDetails>? ChildContent { get; set; }

    [Inject]
    public ISiteDetails SubsiteService { get; set; } = null!;

    [Inject]
    public AuthenticationStateProvider AuthStateProvider { get; set; } = null!;

    [Inject]
    public IJSRuntime JSRuntime { get; set; } = null!;

    [Inject]
    public ILogger<SiteProvider> Logger { get; set; } = null!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            var isPrivate = await CheckIsPrivateModeAsync();
            _filtered = new Filtered(SubsiteService, state.User, isPrivate);

            StateHasChanged();
        }
    }

    /// <summary>
    /// Detects if the browser is currently in private/incognito mode
    /// </summary>
    /// <returns>True if in private mode, false otherwise</returns>
    public async Task<bool> CheckIsPrivateModeAsync()
    {
        await using var module = await JSRuntime.InvokeAsync<IJSObjectReference>(
            "import",
            "./Components/SiteProvider.razor.js");
        try
        {
            var result = await module.InvokeAsync<bool>("isPrivateMode");

            Logger.LogInformation("Private mode detection result: {IsPrivateMode}", result);

            return result;
        }
        catch (JSException ex)
        {
            // Log the specific JS error
            Logger.LogInformation(ex, "JavaScript error in isPrivateMode");
            return false;
        }
    }

    private sealed class Filtered(ISiteDetails main, ClaimsPrincipal user, bool isPrivate) : ISiteDetails
    {
        public string Name => main.Name;

        public string Description => main.Description;

        public IEnumerable<SubsiteInfo> Sites
        {
            get
            {
                foreach (var site in main.Sites)
                {
                    if (site.IsAuthorized(user))
                    {
                        if (site.IsPrivate && !isPrivate)
                        {
                            continue;
                        }

                        yield return site;
                    }
                }
            }
        }
    }
}
