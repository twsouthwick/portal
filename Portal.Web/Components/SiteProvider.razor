@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

@if (_filtered is { })
{
    @if (ChildContent is { } && _browserInfo is { })
    {
        <CascadingValue TValue="BrowserInfo" Value="_browserInfo">
            <CascadingValue TValue="PortalDetails" Value="_filtered">
                @ChildContent(_filtered)
            </CascadingValue>
        </CascadingValue>
    }
}

@code {
    private PortalDetails? _filtered;
    private BrowserInfo? _browserInfo;

    [Parameter]
    public RenderFragment<PortalDetails>? ChildContent { get; set; }

    [Inject]
    public IPortalProvider PortalProvider { get; set; } = null!;

    [Inject]
    public AuthenticationStateProvider AuthStateProvider { get; set; } = null!;

    [Inject]
    public IClientBrowserSession BrowserSession { get; set; } = null!;

    [Inject]
    public ILogger<SiteProvider> Logger { get; set; } = null!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var portal = await PortalProvider.GetSiteDetailsAsync(default);
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            _browserInfo = await BrowserSession.GetBrowserInfoAsync();

            Logger.LogInformation(
                "Browser Info - Browser: {Browser} [{BrowserVersion}], Platform: {Platform}, Version: {PlatformVersion}, Architecture: {Architecture}, IsMobile: {IsMobile}, IsPrivate: {IsPrivate}",
                _browserInfo.Browser,
                _browserInfo.BrowserVersion,
                _browserInfo.Platform,
                _browserInfo.PlatformVersion,
                _browserInfo.Architecture,
                _browserInfo.IsMobile,
                _browserInfo.IsPrivate);

            var filteredSites = Filter(portal.Sites, state.User, _browserInfo);

            _filtered = portal with { Sites = [.. filteredSites] };

            StateHasChanged();
        }
    }

    private IEnumerable<SiteInfo> Filter(IEnumerable<SiteInfo> other, ClaimsPrincipal user, BrowserInfo browserInfo)
    {
        foreach (var site in other)
        {
            if (site.IsAuthorized(user))
            {
                if (site.IsPrivate && !browserInfo.IsPrivate)
                {
                    continue;
                }

                yield return site with
                {
                    Apps = [.. FilterSupportedApps(site.Apps, browserInfo)]
                };
            }
        }

        static IEnumerable<SiteApp> FilterSupportedApps(IEnumerable<SiteApp> apps, BrowserInfo browserInfo)
        {
            foreach (var app in apps)
            {
                var isApplicable = (app.Store, browserInfo.Platform) switch
                {
                    (AppStore.Apple, BrowserPlatform.MacOS) => true,
                    (AppStore.Apple, BrowserPlatform.iOS) => true,
                    (AppStore.Google, BrowserPlatform.Android) => true,
                    (AppStore.Microsoft, BrowserPlatform.Windows) => true,
                    (AppStore.Windows, BrowserPlatform.Windows) => true,
                    _ => false
                };

                if (isApplicable)
                {
                    yield return app;
                }
            }
        }
    }
}
