@inject ISiteClickTracker ClickTracker

@if (sitesWithClicks.Any())
{
    <SiteGrid Category="Most Used Sites" Sites="@sitesWithClicks" />
}

@if (sitesWithoutClicks.Any())
{
    <SiteGrid Category="Other Sites" Sites="@sitesWithoutClicks" />
}

@code {
    [Parameter, EditorRequired]
    public IEnumerable<SiteInfo> Sites { get; set; } = [];

    private List<SiteInfo> sitesWithClicks = new();
    private List<SiteInfo> sitesWithoutClicks = new();

    protected override async Task OnParametersSetAsync()
    {
        await BuildFrequencySortedSitesAsync();
    }

    private async Task BuildFrequencySortedSitesAsync()
    {
        // Get all click counts
        var clickCounts = await ClickTracker.GetAllClickCountsAsync();

        // Split sites into those with clicks and those without
        sitesWithClicks = Sites
            .Where(s => clickCounts.GetValueOrDefault(s.Id, 0) > 0)
            .OrderByDescending(s => clickCounts.GetValueOrDefault(s.Id, 0))
            .ThenBy(s => s.Name)
            .ToList();

        sitesWithoutClicks = Sites
            .Where(s => clickCounts.GetValueOrDefault(s.Id, 0) == 0)
            .OrderBy(s => s.Name)
            .ToList();
    }
}
