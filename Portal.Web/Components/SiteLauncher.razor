@inject IClientBrowserSession BrowserSession
@inject IDialogService DialogService
@inject ISiteClickTracker ClickTracker

<FluentButton Disabled="@IsDisabled"
              Appearance="ButtonAppearance.Outline"
              OnClick="@LaunchAsync"
              Title="@ButtonTitle">
    <SiteAppIcon Url="@Url" SiteApp="@SiteApp" />
</FluentButton>

@code {
    [Parameter, EditorRequired]
    public string Url { get; set; } = null!;

    [Parameter]
    public bool IsDisabled { get; set; }

    [Parameter]
    public string? AppName { get; set; }

    [Parameter]
    public SiteApp? SiteApp { get; set; }

    [Parameter]
    public string? SiteId { get; set; }

    private bool IsAppProtocol => Url.Contains("://") && !Url.StartsWith("http://", StringComparison.OrdinalIgnoreCase) && !Url.StartsWith("https://", StringComparison.OrdinalIgnoreCase);

    private string ButtonTitle => IsAppProtocol ? $"Open {AppName ?? "App"}" : "Open Web";

    private async Task LaunchAsync()
    {
        if (IsDisabled)
        {
            return;
        }

        // Track the click if SiteId is provided
        if (!string.IsNullOrWhiteSpace(SiteId))
        {
            await ClickTracker.RecordClickAsync(SiteId);
        }

        // For HTTP/HTTPS URLs, open in new tab
        if (!IsAppProtocol)
        {
            await BrowserSession.OpenUrlInNewTabAsync(Url);
            return;
        }

        // For app protocol URLs, check if launch was successful
        if (await BrowserSession.LaunchAppUrlAsync(Url))
        {
            return;
        }

        if (SiteApp is { StoreId: { } id } && !string.IsNullOrEmpty(id))
        {
            await BrowserSession.OpenUrlInNewTabAsync(id);
        }
    }
}
