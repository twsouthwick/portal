@inject IClientBrowserSession BrowserSession
@inject IDialogService DialogService

<FluentButton Disabled="@IsDisabled"
              Appearance="Appearance.Outline"
              OnClick="@LaunchAsync"
              Title="@ButtonTitle">
    <SiteAppIcon Url="@Url" AppStores="@AppStores" />
</FluentButton>

@code {
    [Parameter, EditorRequired]
    public string Url { get; set; } = null!;

    [Parameter]
    public bool IsDisabled { get; set; }

    [Parameter]
    public string? AppName { get; set; }

    [Parameter]
    public IReadOnlyCollection<AppStore>? AppStores { get; set; }

    private bool IsAppProtocol => Url.Contains("://") && !Url.StartsWith("http://", StringComparison.OrdinalIgnoreCase) && !Url.StartsWith("https://", StringComparison.OrdinalIgnoreCase);

    private string ButtonTitle => IsAppProtocol ? $"Open {AppName ?? "App"}" : "Open Web";

    private async Task LaunchAsync()
    {
        if (IsDisabled)
        {
            return;
        }

        // For HTTP/HTTPS URLs, open in new tab
        if (!IsAppProtocol)
        {
            await BrowserSession.OpenUrlInNewTabAsync(Url);
            return;
        }

        // For app protocol URLs, check if launch was successful
        var launched = await BrowserSession.LaunchAppUrlAsync(Url);
        if (!launched)
        {
            await ShowAppNotInstalledDialog();
        }
    }

    private async Task ShowAppNotInstalledDialog()
    {
        var message = "The application for this link is not installed on your device.";
        
        if (AppStores is { Count: > 0 })
        {
            message += "\n\nYou can download it from:";
            foreach (var store in AppStores)
            {
                message += $"\n• {GetStoreName(store.Name)}: {store.Id}";
            }
        }
        else
        {
            message += " Please install the required application and try again.";
        }

        await DialogService.ShowWarningAsync(message, $"{AppName ?? "App"} Not Installed");
    }

    private string GetStoreName(string storeName) => storeName switch
    {
        "google-play" => "Google Play",
        "apple" => "Apple App Store",
        "f-droid" => "F-Droid",
        _ => storeName
    };
}
